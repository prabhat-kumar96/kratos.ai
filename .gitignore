# Dependency directories
node_modules/
__pycache__/
venv/
.env*

myenv/

# OS junk
.DS_Store
Thumbs.db

# Build outputs
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML artifacts — training run logs excluded (large/ephemeral)
mlruns/
