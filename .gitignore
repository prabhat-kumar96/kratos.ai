llm/src/.env.example

# Datasets & Training Data (ignore huge raw dumps, but track baseline market data)
ml_dataset/
!ml/market_data.csv
!ml/narratives.json

# Local Docker overrides
docker-compose.override.yml

# The .env.production template (with CHANGE_ME placeholders) IS tracked.
# After filling in real values, rename to .env.production.local or protect it.
# Alternatively, add these lines to protect the live secret file:
# .env.production.local
# backend/.env.production.local
# frontend/.env.production.local